# Bench-specific values. This is the only place they are declared; sketches are
# never edited to match a bench. The real .env is not committed.
#
#   uv run --env-file .env pytest <experiment file>
#
# See README.ja.md section 4.1.

# --- standing bench v0: no hardware (host Arduino core) ---
# E001 runs with this alone; no board required.
TEST_SERIAL_PORT_HOST=socket://localhost

# --- standing bench v1: one dedicated board ---
# preflight checks this first. Unplug it and it is no longer "standing".
#TEST_STANDING_PROFILE=esp32s3

# --- probe board ports (PROFILE = the sketch.yaml profile name, uppercased) ---
# A real .env may use a stable alias that survives re-plugging, e.g.
#   TEST_SERIAL_PORT_ESP32S3=/run/board-identify/by-id/esp32-s3-xxxxxxxx
# Device locks resolve symlinks before hashing, so an alias still locks the
# physical board. This example file stays environment-neutral.
#TEST_SERIAL_PORT_ESP32S3=/dev/ttyACM0
#TEST_SERIAL_PORT_PICO=/dev/ttyACM1
#TEST_SERIAL_PORT_UNO=/dev/ttyUSB0

# --- standing bench v2: peer pair (GPIO18/19 wired between the two boards) ---
#TEST_SERIAL_PORT_PEER_DEVICE_ESP32S3=/dev/ttyACM1

# --- probe pins, injected into the sketch as compile-time defines ---
# The sketch decides the lane structure (how many, which phy); only the pin
# numbers come from here.
#TEST_LANE0_SWIO=2
#TEST_LANE1_SWCLK=4
#TEST_LANE1_SWDIO=5
#TEST_LANE0_NRST=
#TEST_LANE0_PWR_EN=
#TEST_MARKER_TX=3          # marker line: watched by the LA only, not by the host

# --- what is wired to each lane (used to skip experiments that need it) ---
# Values follow the ch32rv device names (ch32v003 / ch32v103 / ch32v203 /
# ch32v307 / ch32x035 / ch32l103 ...). "loopback" = pseudo phy, no target.
#TEST_TARGET_ESP32S3_LANE0=ch32v003
#TEST_TARGET_ESP32S3_LANE1=ch32v307

# --- logic analyzer (sigrok) ---
# Empty SIGROK_DRIVER skips every experiment that needs an LA.
# SWIO's 290 ns pulse is about 7 samples at 24 MS/s; resolving the ~120 ns rise
# needs 100 MS/s or better.
#SIGROK_DRIVER=fx2lafw
#SIGROK_CONN=
#SIGROK_SAMPLERATE=24000000
#SIGROK_CH_SWIO=D1
#SIGROK_CH_SWCLK=D2
#SIGROK_CH_SWDIO=D3
#SIGROK_CH_MARKER=D0

# --- reference device for comparison runs ---
#TEST_LINKE_PORT=          # WCH-LinkE; empty skips experiments that compare against it

# --- sibling repository (only for experiments that use CH32RVProbe firmware) ---
# Passed to sketch.yaml as `libraries: dir:`.
#TEST_CH32RVPROBE_DIR=../../ch32rv-probe

# --- IP transport experiments ---
#TEST_PROBE_WS_URL=        # e.g. ws://192.168.1.50:3333; empty skips IP experiments
