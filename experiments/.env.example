# 実測ベンチの構成。実体の .env は commit しない(port は環境ごとに違う)。
# 置き場所は uv project の隣 = ch32rv-probe/tests/.env。読ませ方は
#   uv run --env-file .env pytest ...
# ここは雛形。ベンチに合わせて書き換えるのはこのファイルだけで、sketch は触らない。

# --- 常設ベンチ(README.ja.md §4.5)---
# v0 = 実機なし(host Arduino core)。board が無くても E001 は走る
TEST_SERIAL_PORT_HOST=socket://localhost
# v1 = 専有する実機 1 枚。preflight が最初にこれを確認する。抜いたら常設ではない
TEST_STANDING_PROFILE=esp32s3

# --- probe board の port(PROFILE は sketch.yaml の profile 名を大文字化)---
# 実際の .env では、挿し直しで番号が変わらない安定した別名を書いてよい
#   例: TEST_SERIAL_PORT_ESP32S3=/run/board-identify/by-id/esp32-s3-xxxxxxxx
# device lock は symlink を解決してからキーを作るので、別名でも実体に対して排他が効く。
# この .env.example は環境非依存にするため一般的な表記で書く。
TEST_SERIAL_PORT=/dev/ttyUSB0
TEST_SERIAL_PORT_ESP32S3=/dev/ttyACM0
TEST_SERIAL_PORT_PICO=/dev/ttyACM1
TEST_SERIAL_PORT_ESP32=/dev/ttyUSB0
TEST_SERIAL_PORT_UNO=/dev/ttyUSB1

# --- v2 peer(既設の 2 枚。GPIO18/19 が相互直結)---
TEST_SERIAL_PORT_PEER_DEVICE_ESP32S3=/dev/ttyACM1

# --- probe の pin(コンパイル時 define として sketch へ注入)---
# lane の構成(何本・どの phy)は sketch が決め、番号だけここで与える
TEST_LANE0_SWIO=2
TEST_LANE1_SWCLK=4
TEST_LANE1_SWDIO=5
TEST_LANE0_NRST=
TEST_LANE0_PWR_EN=
TEST_MARKER_TX=3                  # LA だけが見る marker 線(ホストには繋がない)

# --- 各 lane に何が繋がっているか(実験の要求判定に使う)---
# 値は ch32rv のデバイス名に合わせる(ch32v003 / ch32v103 / ch32v203 / ch32v307 / ch32x035 / ch32l103 …)
# loopback = 線を出さない疑似 phy(target 不要)
TEST_TARGET_ESP32S3_LANE0=ch32v003
TEST_TARGET_ESP32S3_LANE1=ch32v307
TEST_TARGET_PICO_LANE0=ch32v003
TEST_TARGET_UNO_LANE0=loopback

# --- ロジックアナライザ(sigrok)---
SIGROK_DRIVER=fx2lafw             # 空なら LA 必須の実験は skip
SIGROK_CONN=
SIGROK_SAMPLERATE=24000000        # SWIO の 290 ns パルスは 24 MS/s で約 7 サンプル。
                                  # 立ち上がり(~120 ns)まで見るなら 100 MS/s 以上の機材
SIGROK_CH_SWIO=D1
SIGROK_CH_SWCLK=D2
SIGROK_CH_SWDIO=D3
SIGROK_CH_MARKER=D0

# --- 基準装置・比較対象 ---
TEST_LINKE_PORT=                  # 比較用 WCH-LinkE。空なら基準装置つきの実験は skip

# --- IP transport の実験用 ---
TEST_PROBE_WS_URL=                # 例 ws://192.168.1.50:3333。空なら IP 実験は skip
