                                                        uint32_t bufsize, const void *buffer, uint32_t len) {
   TU_VERIFY(ep > 0, 0); // must be opened
   TU_VERIFY(usbd_edpt_claim(p_itf->rhport, ep), 0);
+#if defined(ESP_USB_DEVICE_EXPERIMENTAL_VENDOR_TX_ZERO_COPY)
+  // E108: hand the caller's buffer straight to the DCD. The caller owns it until
+  // tud_vendor_tx_cb() reports completion, and is not limited to the epbuf size
+  // (only by the 16-bit transfer length of usbd_edpt_xfer).
+  (void) epbuf;
+  (void) bufsize;
+  const uint32_t xact_len = tu_min32(len, 0xffffu);
+  TU_ASSERT(usbd_edpt_xfer(p_itf->rhport, ep, (uint8_t *) buffer, (uint16_t) xact_len, false), 0);
+#else
   const uint32_t xact_len = tu_min32(len, bufsize);
   memcpy(epbuf, buffer, xact_len);
   TU_ASSERT(usbd_edpt_xfer(p_itf->rhport, ep, epbuf, (uint16_t) xact_len, false), 0);
+#endif
   return xact_len;
 }
 
 TU_ATTR_UNUSED static inline uint32_t vendord_ep_write_available(vendord_interface_t *p_itf, uint8_t ep, uint32_t bufsize) {
   TU_VERIFY(ep > 0, 0); // must be opened
+#if defined(ESP_USB_DEVICE_EXPERIMENTAL_VENDOR_TX_ZERO_COPY)
+  (void) bufsize;
+  return usbd_edpt_busy(p_itf->rhport, ep) ? 0 : 0xffffu;
+#else
   return usbd_edpt_busy(p_itf->rhport, ep) ? 0 : bufsize;
+#endif
 }
 
